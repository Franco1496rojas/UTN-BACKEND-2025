################################################################################
# 🛣️ MS-OPERACIONES - TRAMOS (ROL: ADMIN + TRANSPORTISTA)
################################################################################

### Listar todos los tramos (ADMIN)
GET {{gateway}}/api/tramos
Authorization: Bearer TOKEN_ADMIN_AQUI

### Filtrar tramos por ruta (ADMIN)
GET {{gateway}}/api/tramos?rutaId=1
Authorization: Bearer TOKEN_ADMIN_AQUI

### Crear tramo (ADMIN - normalmente se crean automáticamente)
POST {{gateway}}/api/tramos
Content-Type: application/json
Authorization: Bearer TOKEN_ADMIN_AQUI

{
  "origen": "Córdoba",
  "destino": "Buenos Aires",
  "distanciaKm": 700.0,
  "costoEstimado": 70000.0,
  "duracionMinutos": 600,
  "orden": 1,
  "estado": "ESTIMADO",
  "tipo": "ORIGEN_DESTINO",
  "ruta": { "id": 1 }
}

### Asignar camión a tramo (PROGRAMADA → ASIGNADA) (ADMIN)
POST {{gateway}}/api/tramos/1/asignar-camion
Content-Type: application/json
Authorization: Bearer TOKEN_ADMIN_AQUI

{
  "camionId": 1
}

### Iniciar tramo (ASIGNADA → EN_TRANSITO) (TRANSPORTISTA)
POST {{gateway}}/api/tramos/1/iniciar
Content-Type: application/json
Authorization: Bearer TOKEN_TRANSP_AQUI

### Finalizar tramo (EN_TRANSITO → COMPLETADA) (TRANSPORTISTA)
POST {{gateway}}/api/tramos/1/finalizar
Content-Type: application/json
Authorization: Bearer TOKEN_TRANSP_AQUI

{
  "fechaHoraFinReal": "2025-11-16T18:00:00",
  "distanciaKmReal": 710.5,
  "duracionMinReal": 620,
  "costoReal": 0
}

