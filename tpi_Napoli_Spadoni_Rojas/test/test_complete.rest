################################################################################
# 🔄 FLUJO COMPLETO DE EJEMPLO
################################################################################

### PASO 1: Login como CLIENTE
# Ejecutar el login de CLIENTE arriba y copiar el token

### PASO 2: Registrar solicitud completa
POST {{gateway}}/api/solicitudes/registrar
Content-Type: application/json
Authorization: Bearer TOKEN_CLIENTE_AQUI

{
  "clienteDni": "11223344",
  "clienteNombre": "Test Usuario",
  "clienteEmail": "test@example.com",
  "clienteTelefono": "3511111111",
  "contenedorPeso": 3000.0,
  "contenedorVolumen": 4.0,
  "contenedorCodigo": "CONT-FLOW-001",
  "origen": "Córdoba",
  "destino": "Buenos Aires",
  "observaciones": "Flujo de prueba completo"
}

### PASO 3: Asignar ruta directa (usar ID de la solicitud creada)
POST {{gateway}}/api/solicitudes/1/asignar-ruta
Content-Type: application/json
Authorization: Bearer TOKEN_CLIENTE_AQUI

{
  "tipo": "directa"
}

### PASO 4: Login como ADMIN y ver camiones disponibles
GET {{gateway}}/api/camiones/disponibles?pesoMaximo=3000&volumenMaximo=4
Authorization: Bearer TOKEN_ADMIN_AQUI

### PASO 5: Asignar camión al tramo (usar ID del tramo creado)
POST {{gateway}}/api/tramos/1/asignar-camion
Content-Type: application/json
Authorization: Bearer TOKEN_ADMIN_AQUI

{
  "camionId": 1
}

### PASO 6: Login como TRANSPORTISTA e iniciar tramo
POST {{gateway}}/api/tramos/1/iniciar
Content-Type: application/json
Authorization: Bearer TOKEN_TRANSP_AQUI

### PASO 7: Ver tramos en curso del transportista
GET {{gateway}}/api/transportistas/1/tramos?estado=INICIADO
Authorization: Bearer TOKEN_TRANSP_AQUI

### PASO 8: Finalizar tramo
POST {{gateway}}/api/tramos/1/finalizar
Content-Type: application/json
Authorization: Bearer TOKEN_TRANSP_AQUI

{
  "fechaHoraFinReal": "2025-11-16T20:00:00",
  "distanciaKmReal": 705.0,
  "duracionMinReal": 600,
  "costoReal": 0
}

### PASO 9: Consultar seguimiento como CLIENTE
GET {{gateway}}/api/seguimientos/solicitud/1
Authorization: Bearer TOKEN_CLIENTE_AQUI

### PASO 10: Ver solicitud completada
GET {{gateway}}/api/solicitudes/1
Authorization: Bearer TOKEN_CLIENTE_AQUI

